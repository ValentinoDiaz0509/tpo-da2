{
  "request": {
    "method": "POST",
    "url": "/events/log",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.event_type_id"
      },
      {
        "matchesJsonPath": "$.publisher_module"
      },
      {
        "matchesJsonPath": "$.payload"
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": 91,
      "event_type_id": 16,
      "publisher_module": "monitoreo",
      "status": "pending"
    }
  }
}
